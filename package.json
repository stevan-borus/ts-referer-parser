{
  "name": "ts-referer-parser",
  "version": "1.1.0",
  "description": "A typed referer parser library",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "biome:lint": "biome lint --write .",
    "biome:format": "biome format --write .",
    "biome:check": "biome check .",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "typescript",
    "referer",
    "referrer",
    "parser"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "Stevan Borus",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevan-borus/ts-referer-parser.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "husky": "^9.1.7",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "js-yaml@<4.2.0": "^4.2.0"
    }
  },
  "packageManager": "pnpm@10.5.0+sha256.e77bc3c5a9888f823fe061413f60ef02afad4b967c9b16b13458279473ba7d1c"
}
